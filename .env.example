# Copie este arquivo para .env e preencha.

AGENCIA_NOME=Agência de Viagens

# Banco de dados. Sem nada aqui, usa o arquivo alertas.db do computador.
# Supabase: cole o endereço "Session pooler" (Connect → Session pooler), com a senha no lugar de [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Troque por um texto longo e aleatório em produção
SECRET_KEY=troque-esta-chave-em-producao
# true quando o site estiver em HTTPS
COOKIE_SEGURO=false

# Primeiro acesso da equipe (criado só se o banco estiver vazio). Troque a senha depois do 1º login.
ADMIN_LOGIN=admin
ADMIN_SENHA=admin123

# Telegram: crie em https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Os grupos lidos agora são cadastrados no site (menu "Grupos do Telegram").
# Esta linha só é usada na primeira vez, para importar grupos já configurados.
TELEGRAM_CANAIS=

# Google Flights via SerpApi: https://serpapi.com
SERPAPI_KEY=
GOOGLE_FLIGHTS_MAX_BUSCAS=20

# Coletas automáticas dentro do próprio site
COLETA_AUTOMATICA=false
INTERVALO_TELEGRAM_MIN=20
INTERVALO_GOOGLE_HORAS=6
INTERVALO_FORMULARIO_MIN=10

# Regras
PROMO_VALIDADE_DIAS=5
CONFIANCA_MINIMA=0.7

# Chave para outros sistemas enviarem promoções via POST /api/promocoes
API_KEY=
